{
  "title": "AI API Assistant — LLM Cost",
  "schemaVersion": 39,
  "uid": "llm-cost-v2",
  "tags": ["v2", "cost", "llm"],
  "time": { "from": "now-24h", "to": "now" },
  "refresh": "1m",
  "panels": [
    {
      "id": 1,
      "title": "Cumulative LLM cost (USD) by model",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 8 },
      "targets": [
        {
          "expr": "sum(llm_cost_usd_total) by (model)",
          "legendFormat": "{{model}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "custom": { "lineWidth": 2, "fillOpacity": 10 }
        }
      }
    },
    {
      "id": 2,
      "title": "Prompt vs completion token ratio over time",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum(rate(llm_prompt_tokens_total[5m])) by (model)",
          "legendFormat": "prompt {{model}}"
        },
        {
          "expr": "sum(rate(llm_completion_tokens_total[5m])) by (model)",
          "legendFormat": "completion {{model}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "tokens/s" }
      }
    },
    {
      "id": 3,
      "title": "LLM cost per hour (USD)",
      "type": "barchart",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum(increase(llm_cost_usd_total[1h])) by (model)",
          "legendFormat": "{{model}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "currencyUSD" }
      },
      "options": {
        "barWidth": 0.7,
        "groupWidth": 0.7,
        "stacking": "normal"
      }
    },
    {
      "id": 4,
      "title": "Estimated tokens saved by tool cache",
      "description": "prompt_tokens * cache_hits_total — approximation of avoided LLM calls",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 16, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum(rate(cache_hits_total{cache_name=\"tool_result\"}[5m])) * 500",
          "legendFormat": "Estimated tokens saved (500 avg prompt tokens/hit)"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "tokens/s" }
      }
    },
    {
      "id": 5,
      "title": "Total tokens consumed (prompt + completion)",
      "type": "stat",
      "gridPos": { "x": 12, "y": 16, "w": 6, "h": 4 },
      "targets": [
        {
          "expr": "sum(llm_prompt_tokens_total) + sum(llm_completion_tokens_total)",
          "legendFormat": "Total tokens"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 6,
      "title": "Total LLM spend (USD, all time)",
      "type": "stat",
      "gridPos": { "x": 18, "y": 16, "w": 6, "h": 4 },
      "targets": [
        {
          "expr": "sum(llm_cost_usd_total)",
          "legendFormat": "Total USD"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 10 },
              { "color": "red", "value": 100 }
            ]
          }
        }
      },
      "options": { "colorMode": "background", "reduceOptions": { "calcs": ["lastNotNull"] } }
    }
  ]
}
